# Copy to .dev.vars for local development (never commit .dev.vars).
# Create a Trakt app at https://trakt.tv/oauth/applications with redirect URI:
#   http://localhost:3000/api/auth/callback
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
# 32+ random characters, e.g. `openssl rand -base64 32`
SESSION_SECRET=
